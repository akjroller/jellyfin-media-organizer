{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jmo:jellyfin-show-organizer:plan:v1",
  "title": "Jellyfin Show Organizer Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "overrides_version", "provenance", "records", "companions"],
  "properties": {
    "schema_version": {"const": 1},
    "overrides_version": {"type": "integer", "minimum": 1},
    "provenance": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/provenance"}]},
    "records": {"type": "array", "items": {"$ref": "#/$defs/planRecord"}},
    "companions": {"type": "array", "items": {"$ref": "#/$defs/companion"}}
  },
  "$defs": {
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "mtime_ns", "sha256"],
      "properties": {
        "size": {"type": "integer", "minimum": 0},
        "mtime_ns": {"type": "integer", "minimum": 0},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "extension", "fingerprint"],
      "properties": {
        "relative_path": {"type": "string", "minLength": 1},
        "extension": {"type": "string", "pattern": "^\\."},
        "fingerprint": {"$ref": "#/$defs/fingerprint"}
      }
    },
    "parse": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["series_hint", "season", "episodes", "absolute_episode", "special_kind", "special_episode", "episode_date", "segment_hint", "year", "embedded_tvmaze_id", "title_hint"],
      "properties": {
        "series_hint": {"type": ["string", "null"]},
        "season": {"type": ["integer", "null"], "minimum": 0},
        "episodes": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "absolute_episode": {"type": ["integer", "null"], "minimum": 0},
        "special_kind": {"enum": ["ova", "oad", null]},
        "special_episode": {"type": ["integer", "null"], "minimum": 1},
        "episode_date": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "segment_hint": {"type": ["string", "null"]},
        "year": {"type": ["integer", "null"], "minimum": 1800},
        "embedded_tvmaze_id": {"type": ["integer", "null"], "minimum": 1},
        "title_hint": {"type": ["string", "null"]}
      }
    },
    "show": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["source_key", "tvmaze_id", "title", "year", "numbering_mode"],
      "properties": {
        "source_key": {"type": "string", "minLength": 1},
        "tvmaze_id": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "year": {"type": ["integer", "null"], "minimum": 1800},
        "numbering_mode": {"enum": ["aired", "absolute", "parenthesized-absolute", "segment-title", "special", "date"]}
      }
    },
    "candidateEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tvmaze_id", "title", "score", "reasons"],
      "properties": {
        "tvmaze_id": {"type": "integer", "minimum": 1},
        "title": {"type": "string"},
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "reasons": {"type": "array", "items": {"type": "string"}}
      }
    },
    "evidence": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["method", "confidence", "reasons", "candidates"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "reasons": {"type": "array", "items": {"type": "string"}},
        "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidateEvidence"}}
      }
    },
    "extra": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["kind", "rule"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "rule": {"type": "string", "minLength": 1}
      }
    },
    "duplicate": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["destination_key", "candidates", "winner", "losers", "confidence", "evidence"],
      "properties": {
        "destination_key": {"type": "string", "minLength": 1},
        "candidates": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "winner": {"type": ["string", "null"]},
        "losers": {"type": "array", "items": {"type": "string"}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "providerEpisode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tvmaze_episode_id", "season", "number", "title", "airdate"],
      "properties": {
        "tvmaze_episode_id": {"type": "integer", "minimum": 1},
        "season": {"type": "integer", "minimum": 0},
        "number": {"type": ["integer", "null"], "minimum": 0},
        "title": {"type": "string", "minLength": 1},
        "airdate": {"type": ["string", "null"]}
      }
    },
    "cacheSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "kind", "request_key", "snapshot_id", "state"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "request_key": {"type": "string", "minLength": 1},
        "snapshot_id": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "state": {"type": "string", "minLength": 1}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_version", "config_snapshot_id", "overrides_snapshot_id", "cache_snapshots"],
      "properties": {
        "tool_version": {"type": "string", "minLength": 1},
        "config_snapshot_id": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "overrides_snapshot_id": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "cache_snapshots": {"type": "array", "items": {"$ref": "#/$defs/cacheSnapshot"}}
      }
    },
    "companion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "extension", "fingerprint", "status", "reason", "source_video", "operation_group_id", "destination", "kind"],
      "properties": {
        "relative_path": {"type": "string", "minLength": 1},
        "extension": {"type": "string", "pattern": "^\\."},
        "fingerprint": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/fingerprint"}]},
        "status": {"enum": ["associated", "duplicate", "ignored", "unresolved"]},
        "reason": {"type": "string", "minLength": 1},
        "source_video": {"type": ["string", "null"]},
        "operation_group_id": {"type": ["string", "null"]},
        "destination": {"type": ["string", "null"]},
        "kind": {"type": ["string", "null"]}
      }
    },
    "planRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "status", "parse", "show", "evidence", "destination", "extra", "duplicate", "operation_group_id", "provider_episodes", "reason"],
      "properties": {
        "source": {"$ref": "#/$defs/source"},
        "status": {"enum": ["matched", "extra", "duplicate", "suspicious", "unresolved"]},
        "parse": {"$ref": "#/$defs/parse"},
        "show": {"$ref": "#/$defs/show"},
        "evidence": {"$ref": "#/$defs/evidence"},
        "destination": {"type": ["string", "null"]},
        "extra": {"$ref": "#/$defs/extra"},
        "duplicate": {"$ref": "#/$defs/duplicate"},
        "operation_group_id": {"type": ["string", "null"]},
        "provider_episodes": {"type": "array", "items": {"$ref": "#/$defs/providerEpisode"}},
        "reason": {"type": ["string", "null"]}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "matched"}}}, "then": {"properties": {"parse": {"type": "object"}, "show": {"type": "object"}, "evidence": {"type": "object"}, "destination": {"type": "string", "minLength": 1}}}},
        {"if": {"properties": {"status": {"const": "extra"}}}, "then": {"properties": {"extra": {"type": "object"}}}},
        {"if": {"properties": {"status": {"const": "duplicate"}}}, "then": {"properties": {"duplicate": {"type": "object"}}}}
      ]
    }
  }
}
